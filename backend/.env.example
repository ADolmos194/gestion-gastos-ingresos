# Django
DJANGO_SECRET_KEY=changeme
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (Postgres)
# Local (compose.dev.yml o postgres propio): postgresql://gastos_ingresos:gastos_ingresos_pass@localhost:5432/gastos_ingresos_local
# Supabase: postgresql://usuario:password@host:5432/postgres
DATABASE_URL=postgresql://gastos_ingresos:gastos_ingresos_pass@localhost:5432/gastos_ingresos_local

# Supabase SDK
SUPABASE_URL=
SUPABASE_KEY=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Despliegue en Render como microservicios separados (Web Service backend + Static Site
# frontend, dos dominios *.onrender.com distintos): el setup de arriba asume mismo origen
# (nginx local). Cross-origin de verdad necesita estas 6 vars además de DATABASE_URL/
# REDIS_*/SECRET_KEY/etc. — sin ellas el navegador no manda la cookie de sesión y el login
# queda roto (aunque CORS_ALLOWED_ORIGINS esté bien):
#   DJANGO_ALLOWED_HOSTS=<backend>.onrender.com
#   CORS_ALLOWED_ORIGINS=https://<frontend>.onrender.com
#   CSRF_TRUSTED_ORIGINS=https://<frontend>.onrender.com
#   SESSION_COOKIE_SAMESITE=None
#   CSRF_COOKIE_SAMESITE=None
#   SESSION_COOKIE_SECURE=True   (y CSRF_COOKIE_SECURE=True — ver bloque HTTPS más abajo;
#                                  Render ya termina TLS, así que estas van en True acá)
# Después hay que replicar <frontend>.onrender.com en connect-src de frontend/public/_headers
# (reemplazando el placeholder <BACKEND_URL> ahí por la URL real del backend) y compilar el
# Static Site con VITE_URL_BASE=https://<backend>.onrender.com.

# Celery (worker de las validaciones de importación de Excel, ver apps.configuraciones.tasks)
# Local (compose.dev.yml, que ya trae el servicio "redis"): redis://redis:6379/0
# Si corrés manage.py runserver por fuera de Docker, apuntá a un Redis local: redis://localhost:6380/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# HTTPS (ver config/settings.py) — dejar todo en False/0 hasta tener un dominio con
# certificado real. Activar recién ahí, y con nginx (u otro proxy) siempre delante:
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_TRUST_PROXY_SSL_HEADER=True   (requiere que el proxy sobreescriba X-Forwarded-Proto)
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# Panel de administración de Django: OUT por defecto en producción (ver ENABLE_ADMIN en
# config/settings.py). El admin no tiene 2FA ni bloqueo de cuenta, solo el rate-limit de
# nginx — la mayor superficie de ataque del proyecto. Dejar vacío (o False) salvo que se
# quiera abrir el admin y se asuma ese riesgo explícito.
DJANGO_ENABLE_ADMIN=

# Registro abierto (POST /api/auth/register/): False por defecto (seguro). Cualquier
# usuario nuevo queda con el rol base y sus permisos; activar solo para dev/probar.
DJANGO_ALLOW_REGISTRATION=False

# Clave del backup cifrado de Postgres (scripts/backup_db.sh). Generá una fuerte y guardala
# a buen resguardo: sin esta clave NO se puede descifrar un backup del que dependa la
# recuperación. El script se niega a correr si está vacía (nunca escribe en claro).
# Generación: python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKUP_ENCRYPTION_PASSPHRASE=

# Stack completo (docker-compose.yml de la raíz: nginx + postgres + backend + worker) —
# Django no lee estas, las usa Compose para armar postgres/redis/nginx (ver ese archivo).
# IMPORTANTE: si este stack va a exponerse más allá de tu localhost, generá passwords
# fuertes acá (ej: python -c "import secrets; print(secrets.token_urlsafe(24))"); el
# staging/prod de ese compose exige REDIS_PASSWORD (la interpolación falla si queda vacía).
DB_NAME=gastos_ingresos
DB_USER=gastos_ingresos
DB_PASSWORD=gastos_ingresos_pass
REDIS_PASSWORD=

# Puerto del host donde queda nginx (todo el stack se accede por acá: http://localhost).
HTTP_PORT=80
HTTPS_PORT=443

# Origen público completo. Con HTTP_PORT=80 va SIN ":80" (los navegadores omiten el
# puerto por defecto en el header Origin/Referer que Django valida contra
# CSRF_TRUSTED_ORIGINS) — si cambiás HTTP_PORT, agregalo acá también
# (ej: http://localhost:8080) y quedará mal el login/CSRF hasta que coincidan.
PUBLIC_ORIGIN=http://localhost
